# מעתיקים את הערכים האלה למשתני הסביבה של השירות. לא מעלים אותם לגיטהאב.

# --- סודות ---
# הטוקן של ימות: מספר המערכת ונקודתיים והסיסמה
YEMOT_TOKEN=0771234567:הסיסמה
# מפתח Gemini לתמלול ההקלטה (כמה מפתחות מופרדים בפסיק)
GEMINI_API_KEYS=AIza...

# --- שלוחות ---
# שלוחת הקבצים בימות: תיקייה רגילה (לא API). שם נשמרות ההקלטות והקטעים.
EXT_PATH=8

# --- התנהגות (יש ברירת מחדל לכולם, אפשר לדלג) ---
# GREETING=שלום. אמור את שם השיר שתרצה לשמוע ובסיום הקש סולמית
# REC_MAX=10          שניות מקסימום להקלטת שם השיר
# SEG_SEC=15          אורך קטע בשניות
# CHAIN=4             כמה קטעים בכל סבב. SEG_SEC*CHAIN = שניות מוזיקה בין רווח לרווח
# SONG_MAX_MIN=10     מקסימום דקות לשיר
# LOOKAHEAD=8         כמה קטעים מעלים מראש לפני מקום ההשמעה
# STT_MODEL=gemini-3.5-flash
