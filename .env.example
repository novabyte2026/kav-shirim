# משתני הסביבה של השירות ב-Render. לא מעלים ערכים אמיתיים לגיטהאב.

# --- סודות (חובה) ---
YEMOT_TOKEN=0771234567:password
GEMINI_API_KEYS=AIza...            # אפשר כמה, מופרדים בפסיק
COOKIES_B64=...                    # מייצרים עם "חידוש-חיבור-יוטיוב.cmd"

# --- שלוחות ---
EXT_PATH=8                         # עבודה: הקלטות, קובץ שקט, אינדקס
LIB_PATH=6                         # ספריית השירים

# --- רשות (לכולם יש ברירת מחדל) ---
# GREETING=ברוכים הבאים לקו השירים...
# STT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# YEMOT_STT=1          גיבוי לתמלול בזיהוי הדיבור של ימות (צורך יחידות). 0 = כבוי
# SONG_MAX_MIN=12      אורך שיר מקסימלי בדקות
# REC_MAX=10           שניות להקלטת שם השיר
# WAIT_MS=420000       כמה זמן מתקשר ממתין להורדה
# LIB_AUTOSETUP=1      הגדרת שלוחת הספרייה כהשמעת קבצים אם אין לה סוג. 0 = לא לגעת
# AUDIO_FILTER=        עיבוד שמע ב-ffmpeg, למשל highpass=f=100,dynaudnorm
# LOG_IVR=1            רישום כל תשובה לימות בלוג
