// Codespace של קו שירים AI.
// רץ את אותה תמונת Docker של הייצור (../Dockerfile) — אותו yt-dlp, ffmpeg,
// Deno וספק ה-PO Token בדיוק. ההבדל היחיד: מכונה חזקה (2 ליבות, 8GB) במקום
// 0.1 ליבה ו-512MB של Render.
//
// הסודות YEMOT_TOKEN ו-GEMINI_API_KEYS מוזרקים אוטומטית מ-Codespaces secrets
// של החשבון. אין צורך להזכיר אותם כאן.
{
  "name": "kav-shirim",

  // בונה את תמונת הייצור. כל הכלים (yt-dlp, ffmpeg, Deno, ספק PO Token,
  // node_modules) נאפים לתוך /app בדיוק כמו ב-Render / גוגל קלאוד.
  "build": { "dockerfile": "../Dockerfile" },

  // github-cli: צריך אותו כדי להפוך את הפורט לציבורי מתוך ה-Codespace.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // שלוחת הקבצים בימות היא 8 (ברירת המחדל בקוד היא 1).
  "containerEnv": {
    "EXT_PATH": "8",
    "PORT": "3000"
  },

  // מעבירים את פורט 3000 החוצה, כציבורי, כדי שהשרתים של ימות (שלא מאחורי
  // נטפרי) יוכלו לפנות אליו ישירות.
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "kav-shirim",
      "visibility": "public",
      "onAutoForward": "silent"
    }
  },

  // רץ כ-root כדי שהשרת וספק ה-PO Token יעבדו בלי הגבלות הרשאה.
  "remoteUser": "root",

  // כל פעם שה-Codespace עולה: מפעיל את השרת, בודק אותו, ודוחף דוח לענף
  // codespace-report כדי שאפשר יהיה לקרוא אותו מרחוק.
  "postStartCommand": "bash .devcontainer/boot.sh"
}
